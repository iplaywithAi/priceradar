{
  "name": "priceradar",
  "version": "1.0.0",
  "description": "PriceRadar: a scraping site with an admin panel, scheduled scrapes and a Firestore product database for a future ecommerce project",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "prestart": "vite build",
    "start": "node server/index.js",
    "check": "node --check server/index.js",
    "firestore:indexes": "npx firebase-tools deploy --only firestore:indexes",
    "fixture": "node scripts/fixture-store.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "emulator": "npx firebase-tools emulators:start --only firestore"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "ISC",
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "puppeteer": "^25.9.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "vite": "^8.3.4"
  }
}
